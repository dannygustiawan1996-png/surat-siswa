# Salin ke Environment Variables di Vercel (Project → Settings → Environment Variables)
# JANGAN commit nilai asli ke Git.

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # boleh dipakai di browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # RAHASIA — hanya di server (API)

# Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Cek nama model terbaru di https://docs.claude.com/en/docs/about-claude/models
AI_MODEL=claude-sonnet-5

# Batas & aturan (opsional, ada nilai default di lib/tka/config.js)
TKA_AI_BATAS_HARIAN=30
TKA_POIN_BATAS_HARIAN_PER_MAPEL=60
TKA_MIN_DETIK_JAWAB=3
